GARMIN_EMAIL=
GARMIN_PASSWORD=

# LLM provider: bedrock (default) | azure_openai (legacy, needs `pip install .[azure]`)
LLM_PROVIDER=bedrock
# Bedrock uses your AWS credentials (~/.aws locally, the execution role on Lambda).
# Optional overrides:
# BEDROCK_REGION=ap-southeast-1
# BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-5-5
# BEDROCK_FALLBACK_MODEL_ID=global.anthropic.claude-opus-4-8
# BEDROCK_EFFORT=medium

# Timezone that decides which date is "today" (unset = this machine's zone).
# HAKIGAINS_TZ=Asia/Singapore

# Coach memory (optional). Unset = no memory. On AWS the SAM template creates an
# AgentCore Memory and sets this for the Lambdas; copy the CoachMemoryId output
# here to use the same memory from a local run.
# HAKIGAINS_MEMORY_ID=
# HAKIGAINS_MEMORY_REGION=ap-southeast-1

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
